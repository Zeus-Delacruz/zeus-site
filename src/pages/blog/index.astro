---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog — Field Notes & Dispatches | Zeus DeLaCruz" description="Build logs, teardowns, and lessons from running sovereign infrastructure — AI agents, TAK, NATS, robotics. New posts weekly.">
  <section class="hero-full" style="min-height:auto;padding:3rem 0 2rem !important;">
    <div class="hero-badge">FIELD NOTES</div>
    <h1 style="font-size:clamp(2rem, 5vw, 3.4rem);">Build logs & <span class="accent">dispatches.</span></h1>
    <p class="hero-sub">Every build decision gets documented — week by week, commit by commit. This is the written record of sovereign infrastructure coming together.</p>
    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:1.75rem;">
      <span class="stat-chip">🏗️ Build-in-Public</span>
      <span class="stat-chip">🧠 AI Agents</span>
      <span class="stat-chip">🗺️ TAK</span>
      <span class="stat-chip">📡 NATS</span>
      <span class="stat-chip">🤖 Robotics</span>
    </div>
  </section>

  <section style="padding:1.5rem 0 4rem !important;">
    <div class="card-grid">
      {posts.map((post) => (
        <div class="card post-card">
          <div class="post-meta">
            {post.data.pubDate.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}
          </div>
          <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p class="post-excerpt">{post.data.description}</p>
          <div style="margin-top:0.75rem;">
            {post.data.tags.map((t) => (
              <a href="/blog/" class="post-tag" style="margin-right:0.4rem;text-decoration:none;">{t}</a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div style="text-align:center;margin-top:3.5rem;">
      <p class="text-muted" style="margin-bottom:1rem;">3 YouTube longs per week → each becomes a post here. The blog is the permanent layer.</p>
      <a href="/resources/starter-kit/" class="btn-primary">Get the Starter Kit →</a>
    </div>
  </section>
</BaseLayout>
