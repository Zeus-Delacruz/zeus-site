---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Community — OneMind OS" description="Join the OneMind community — build alongside us.">
<!-- Community v2 | /resources/community/ -->
<section class="hero-full" style="min-height:auto;padding:3rem 0 2rem;">
  <div class="hero-badge">THE HUB</div>
  <h1 style="font-size:2.8rem;">Sovereign Ops <span style="color:var(--accent-bright);">Community</span></h1>
  <p class="hero-sub" style="font-size:1.15rem;max-width:620px;">The place where builders converge. Weekly live ops calls. Build logs. Full template vault. Direct access to Zeus, Legacy, and the 4 pillar agents. Hosted on Circle.so at onemindos.com.</p>
  <div style="margin-top:1.5rem;">
    <a href="https://onemindos.com" class="btn-primary" style="display:inline-block;font-size:1.1rem;padding:16px 36px;">Join the Community →</a>
  </div>
</section>

<section style="padding:2rem 0;border-top:1px solid var(--line);">
  <h2 style="color:var(--accent-bright);margin-bottom:1.5rem;">What's Inside</h2>
  <div class="card-grid two-col">
    <div class="card"><h4>📣 Announcements</h4><p>Zeus voice. Product launches, stack updates, new templates. What's shipping this week.</p></div>
    <div class="card"><h4>🙋 Introduce Yourself</h4><p>Onboarding ritual: post your stack goal. The community knows what you're building and helps you get there.</p></div>
    <div class="card"><h4>🔨 Build Logs</h4><p>The heart of the community. Members post their builds — hardware, configs, dashboards. Levels unlock at milestones. The best builds get featured.</p></div>
    <div class="card"><h4>📚 Sovereign Stack Classroom</h4><p>All 8 course modules live here. Video, text, templates. Self-paced or cohort. Graduates get Operator level.</p></div>
    <div class="card"><h4>🔴 Live Ops Room</h4><p>Weekly live call. Zeus walks through what he built that week. Q&A. Stack reviews. Recordings stay in the vault forever.</p></div>
    <div class="card"><h4>🏆 Wins & Field Reports</h4><p>The proof wall. Member deployments. Real stacks running in the wild. These become case studies, testimonials, and marketing.</p></div>
    <div class="card"><h4>🤖 Ask Legacy</h4><p>AI-assisted Q&A. Legacy monitors the community and answers technical questions. The knowledge base becomes a product.</p></div>
    <div class="card"><h4>📁 Template Vault</h4><p>docker-compose variants. NATS subject maps. TAK configs. Grafana dashboards. Every template the community builds. Organized, searchable, versioned.</p></div>
  </div>
</section>

<section style="padding:2rem 0;border-top:1px solid var(--line);">
  <h2 style="color:var(--accent-bright);margin-bottom:1rem;">Pricing</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;">
    <div style="background:var(--black-2);border:1px solid var(--line);border-radius:0.5rem;padding:1.5rem;">
      <h4>🚀 Founding Member</h4>
      <p style="font-size:1.8rem;color:var(--accent-bright);margin:0.5rem 0;">$49<span style="font-size:1rem;">/mo</span></p>
      <p style="font-size:0.9rem;">First 50 members only. <strong>Price locked for life.</strong> Permanent Founding Member badge. Same access as full membership. Annual = 2 months free ($490/yr).</p>
      <p style="font-size:0.85rem;color:var(--accent-bright);margin-top:0.5rem;">⚠️ Spots remaining: first 50 — claim yours</p>
    </div>
    <div style="background:var(--black-2);border:1px solid var(--line);border-radius:0.5rem;padding:1.5rem;">
      <h4>⚡ Full Membership</h4>
      <p style="font-size:1.8rem;color:var(--accent-bright);margin:0.5rem 0;">$99<span style="font-size:1rem;">/mo</span></p>
      <p style="font-size:0.9rem;">After founding 50 fill. Full access — all spaces, all templates, all recordings, weekly live calls. Annual = 2 months free ($990/yr).</p>
    </div>
  </div>
  <p style="margin-top:1.5rem;"><strong>14-day no-questions refund.</strong> Annual always saves 2 months. Every member gets NATS access to task the agents. No per-seat pricing. No "team plan." One price, full access.</p>
</section>

<section style="padding:2rem 0;border-top:1px solid var(--line);">
  <h2 style="color:var(--accent-bright);margin-bottom:1rem;">Member Levels</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;">
    <div><h4>👀 Visitor</h4><p style="font-size:0.85rem;">Free preview space. See announcements, read public build logs. Get a taste before joining.</p></div>
    <div><h4>⚡ Member</h4><p style="font-size:0.85rem;">$49 or $99/mo. Full access. Build logs, templates, live calls, recordings, agent access.</p></div>
    <div><h4>🏅 Founding Member</h4><p style="font-size:0.85rem;">Permanent badge. Locked $49 price. Same access as Member. Bragging rights.</p></div>
    <div><h4>🎖️ Operator</h4><p style="font-size:0.85rem;">Cohort graduates. Advanced spaces. 1-on-1 channel with Zeus. Priority agent routing.</p></div>
  </div>
</section>

<div style="text-align:center;padding:2rem 0;">
  <a href="https://onemindos.com" class="btn-primary" style="display:inline-block;font-size:1.1rem;">Join at onemindos.com →</a>
  <p style="margin-top:0.75rem;font-size:0.85rem;color:#9ca3af;">Hosted on Circle.so. 14-day trial available. Business plan = full automations.</p>
</div>
</BaseLayout>
