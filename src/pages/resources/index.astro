---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Resources — Zeus DeLaCruz" description="Free resources — starter kit, GitHub repos, and the community.">
<!-- Resources Hub v2 | /resources/ -->
<section class="hero-full" style="min-height:auto;padding:3rem 0 2rem;">
  <div class="hero-badge">FREE</div>
  <h1 style="font-size:2.8rem;">Everything you need to <span style="color:var(--accent-bright);">start building</span> — free.</h1>
  <p class="hero-sub" style="font-size:1.1rem;max-width:620px;">Templates, configs, source code, and the community. Take it. Build with it. The only thing I ask is that you build something real.</p>
</section>

<section style="padding:2rem 0;">
  <div class="card-grid two-col">
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>🚀 Sovereign Stack Starter Kit</h4>
      <p style="font-size:0.95rem;">The 10-command architecture. Full docker-compose. NATS subject map. OneMind stack diagram. The exact configs I use. Download and deploy in 30 minutes.</p>
      <a href="/resources/starter-kit/" class="btn-primary" style="display:inline-block;font-size:0.85rem;margin-top:0.75rem;">Get It Free →</a>
    </div>
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>💻 GitHub Repos</h4>
      <p style="font-size:0.95rem;">All the code I write on YouTube. omos-legacy (the brain), omos (the body), omos-ui (the face), OneTAK (the eyes). Open source. Fork it.</p>
      <a href="/resources/github/" class="btn-primary" style="display:inline-block;font-size:0.85rem;margin-top:0.75rem;">Browse Repos →</a>
    </div>
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>🏘️ Sovereign Ops Community</h4>
      <p style="font-size:0.95rem;">Circle.so community. Weekly live ops calls. Build logs. Template vault. Direct access to me and the agents. $49/mo founding — first 50 lock that price forever.</p>
      <a href="/resources/community/" class="btn-primary" style="display:inline-block;font-size:0.85rem;margin-top:0.75rem;">Join →</a>
    </div>
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>🎥 YouTube Build Logs</h4>
      <p style="font-size:0.95rem;">Every build, live. 3 videos a week. The entire OneMind stack documented in real time. Subscribe and build along.</p>
      <a href="#" class="btn-primary" style="display:inline-block;font-size:0.85rem;margin-top:0.75rem;">Watch →</a>
    </div>
  </div>
</section>

<div style="text-align:center;padding:2rem 0;">
  <p style="font-size:0.85rem;color:#9ca3af;">Everything here is self-hosted, open-source, or community-owned. No vendor lock-in. No "free trial that becomes $300/month." Build it once, own it forever.</p>
</div>
</BaseLayout>
