import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Speaking — Zeus DeLaCruz" description="Talks on AI agents, sovereign infrastructure, TAK, and the OneMind OS build.">
<!-- Speaking v2 | /services/speaking/ -->
<section class="hero-full" style="min-height:auto;padding:3rem 0 2rem;">
  <div class="hero-badge">STAGE & STREAM</div>
  <h1 style="font-size:2.8rem;">I speak on <span style="color:var(--accent-bright);">sovereign infrastructure</span> and the future of self-hosted intelligence.</h1>
</section>

<section style="padding:2rem 0;">
  <h2 style="color:var(--accent-bright);margin-bottom:1.5rem;">Topics</h2>
  <div class="card-grid two-col">
    <div class="card"><h4>🏰 The Sovereign Stack</h4><p>Why renting intelligence is a trap. How to build an AI operating system on hardware you own. The Docker Compose that replaces 12 SaaS subscriptions. Technical, provocative, live demo.</p></div>
    <div class="card"><h4>🧠 Agent Fabrics</h4><p>Multi-agent systems on a message bus. Why NATS is the nervous system AI never had. How 5 specialized agents outperform one general model. Live agent orchestration on stage.</p></div>
    <div class="card"><h4>🗺️ TAK for Everyone</h4><p>Why the DoD's common operating picture belongs in civilian hands. Situational awareness for homesteads, communities, events. The TAK2030 moment and what it means.</p></div>
    <div class="card"><h4>🚀 Build in Public</h4><p>How I'm building a $50K/month business live on YouTube. The content engine that feeds the funnel. Why transparency is the best marketing. Lessons from shipping every week.</p></div>
  </div>
</section>

<section style="padding:2rem 0;border-top:1px solid var(--line);">
  <h2 style="color:var(--accent-bright);margin-bottom:1rem;">Formats</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
    <div><h4>🎤 Keynote</h4><p>45-60 min. Big vision. Live demos. Best for conferences and main stages.</p></div>
    <div><h4>🔧 Workshop</h4><p>2-4 hours. Hands-on. Attendees leave with a running stack. Best for technical audiences.</p></div>
    <div><h4>🎙️ Panel</h4><p>Moderated discussion. Good for adding the builder perspective to AI/infra panels.</p></div>
    <div><h4>💻 Virtual</h4><p>Same content, remote. Screen sharing for live demos. Recorded for replay.</p></div>
  </div>
</section>

<div style="text-align:center;padding:2rem 0;">
  <a href="/contact/" class="btn-primary" style="display:inline-block;font-size:1rem;">Book Me →</a>
  <p style="margin-top:0.75rem;font-size:0.85rem;color:#9ca3af;">⚠️ Zoho booking form here — include event type, date, audience size</p>
</div>
</BaseLayout>
