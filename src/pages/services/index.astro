---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Services — Zeus DeLaCruz" description="Consulting, coaching, speaking, and system building — done-with-you sovereign infrastructure.">
<!-- Services Hub v2 | /services/ -->
<section class="hero-full" style="min-height:auto;padding:3rem 0 2rem;">
  <div class="hero-badge">WORK WITH ME</div>
  <h1 style="font-size:2.8rem;">I build <span style="color:var(--accent-bright);">sovereign infrastructure</span> for people who want to own their stack.</h1>
  <p class="hero-sub" style="font-size:1.1rem;max-width:620px;">Four ways to work together — from a 15-minute call to a fully deployed OneMind system on your hardware. Every engagement ships something real.</p>
</section>

<section style="padding:2rem 0;">
  <div class="card-grid two-col" style="margin-top:0.5rem;">
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>🎯 Consulting</h4>
      <p style="font-size:0.95rem;">Done-with-you. 2-week or 4-week sprint. We pair on your stack — architecture, NATS topology, TAK deployment, agent config. You own the result.</p>
      <p style="font-size:0.85rem;color:var(--accent-bright);margin-top:0.5rem;">$2,500 (2 weeks) · $5,000 (4 weeks)</p>
      <a href="/services/consulting/" style="color:var(--accent-bright);font-size:0.85rem;">Details →</a>
    </div>
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>🧭 Coaching</h4>
      <p style="font-size:0.95rem;">1-on-1 across all 4 pillars — tech, performance, home, business. Weekly sessions. Accountability. Direct access to me and the agents.</p>
      <p style="font-size:0.85rem;color:var(--accent-bright);margin-top:0.5rem;">Custom · Apply below</p>
      <a href="/services/coaching/" style="color:var(--accent-bright);font-size:0.85rem;">Apply →</a>
    </div>
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>🎤 Speaking</h4>
      <p style="font-size:0.95rem;">Keynotes, workshops, panels. Topics: sovereign AI, self-hosted infrastructure, TAK for civilians, the agent fabric. In-person or virtual.</p>
      <p style="font-size:0.85rem;color:var(--accent-bright);margin-top:0.5rem;">Custom · Inquire</p>
      <a href="/services/speaking/" style="color:var(--accent-bright);font-size:0.85rem;">Book →</a>
    </div>
    <div class="card" style="border-left:3px solid var(--accent-bright);">
      <h4>🏗️ System Building</h4>
      <p style="font-size:0.95rem;">Done-for-you. I spec, build, ship, and install a complete OneMind system on your hardware. Includes training + 30-day handoff.</p>
      <p style="font-size:0.85rem;color:var(--accent-bright);margin-top:0.5rem;">$7,500 – $15,000</p>
      <a href="/services/system-building/" style="color:var(--accent-bright);font-size:0.85rem;">Details →</a>
    </div>
  </div>
</section>

<section style="padding:2rem 0;border-top:1px solid var(--line);">
  <h2 style="color:var(--accent-bright);margin-bottom:1rem;">How I Work</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1rem;">
    <div><h4 style="margin-bottom:0.25rem;">1. Discovery Call</h4><p style="font-size:0.9rem;">15 minutes. Free. We figure out what you actually need — not what you think you need. Most people over-buy infrastructure.</p></div>
    <div><h4 style="margin-bottom:0.25rem;">2. Scoped Proposal</h4><p style="font-size:0.9rem;">Fixed scope. Fixed price. Fixed timeline. No hourly billing. No scope creep. You know exactly what you're getting before we start.</p></div>
    <div><h4 style="margin-bottom:0.25rem;">3. Build + Ship</h4><p style="font-size:0.9rem;">I build on your hardware or mine. You watch the process live if you want — I build in public. Every commit is visible.</p></div>
    <div><h4 style="margin-bottom:0.25rem;">4. Handoff + Support</h4><p style="font-size:0.9rem;">Documentation. Training session. 30-day support window. After that, the community and the agents keep you running.</p></div>
  </div>
</section>

<div style="text-align:center;padding:2rem 0;">
  <a href="/contact/" class="btn-primary" style="display:inline-block;font-size:1rem;">Start With a Call →</a>
  <p style="margin-top:0.75rem;font-size:0.85rem;color:#9ca3af;">⚠️ Zoho booking form — drop me the embed code and I'll wire it here</p>
</div>
</BaseLayout>
