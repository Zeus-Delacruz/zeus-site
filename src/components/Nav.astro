---
// Nav.astro — Zeus DeLaCruz site navigation v3.0
// One file. Used on every page via BaseLayout.
---

<nav class="zeus-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">Zeus DeLaCruz</a>

    <!-- Desktop nav -->
    <div class="nav-desktop">

      <!-- Services dropdown -->
      <div class="mega-parent">
        <button class="mega-trigger" onclick="toggleDropdown('mega-dropdown-services',this)">Services ▾<span class="mega-chevron">⌄</span></button>
        <div class="mega-dropdown mega-dropdown--sm" id="mega-dropdown-services">
          <a href="/services/consulting/" class="mega-item">
            <div class="mega-item-label">Consulting</div>
            <div class="mega-item-desc">Done-with-you sprints — $2,500/$5,000</div>
          </a>
          <a href="/services/coaching/" class="mega-item">
            <div class="mega-item-label">Coaching</div>
            <div class="mega-item-desc">4-pillar 1-on-1 weekly sessions</div>
          </a>
          <a href="/services/speaking/" class="mega-item">
            <div class="mega-item-label">Speaking</div>
            <div class="mega-item-desc">Keynotes, workshops, panels</div>
          </a>
          <a href="/services/system-building/" class="mega-item">
            <div class="mega-item-label">System Building</div>
            <div class="mega-item-desc">Done-for-you — $7,500/$15,000</div>
          </a>
        </div>
      </div>

      <!-- OneMind OS mega-menu -->
      <div class="mega-parent">
        <button class="mega-trigger" onclick="toggleDropdown('mega-dropdown-onemind',this)">OneMind OS ▾<span class="mega-chevron">⌄</span></button>
        <div class="mega-dropdown" id="mega-dropdown-onemind">
