---
// BaseLayout.astro — Chrome wrapper for every page v3.4
// Props: title, description, image (og:image path, optional)
import Nav from '../components/Nav.astro';

const {
  title = 'Zeus DeLaCruz — Builder, Operator, Architect',
  description = 'I build sovereign infrastructure — AI agents, meshed networks, robotic systems, and the operating system that runs them all. Self-hosted. Open-source. Yours forever.',
  image = '/images/og-default.png'
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Zeus DeLaCruz" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter/X card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles/zeus.css" />
</head>
<body>
  <Nav />

  <main>
    <slot />
  </main>

  <footer class="zeus-footer">
    <div class="footer-inner">
      <div class="footer-col">
        <div class="footer-brand">Zeus DeLaCruz</div>
        <p style="max-width:240px;">Building sovereign infrastructure — AI, TAK, NATS, robotics. Self-hosted. Open core. Yours forever.</p>
        <div style="display:flex;gap:0.5rem;margin-top:0.75rem;">
          <a href="https://youtube.com/@zeusdelacruz" class="footer-social-icon" target="_blank">▶</a>
          <a href="https://x.com/zeusdelacruz" class="footer-social-icon" target="_blank">𝕏</a>
          <a href="https://instagram.com/zeusdelacruz" class="footer-social-icon" target="_blank">◉</a>
          <a href="https://tiktok.com/@zeusdelacruz" class="footer-social-icon" target="_blank">♪</a>
          <a href="https://github.com/onemindos" class="footer-social-icon" target="_blank">⌥</a>
          <a href="https://linkedin.com/in/zeusdelacruz" class="footer-social-icon" target="_blank">in</a>
        </div>
      </div>

      <div class="footer-link-group">
        <div class="footer-link-heading">Services</div>
        <a href="/services/consulting/">Consulting</a>
        <a href="/services/coaching/">Coaching</a>
        <a href="/services/speaking/">Speaking</a>
        <a href="/services/system-building/">System Building</a>
      </div>

      <div class="footer-link-group">
        <div class="footer-link-heading">OneMind OS</div>
        <a href="/onemind/">Overview</a>
        <a href="/onemind/agents/">AI Agents</a>
        <a href="/onemind/agents/legacy/">Legacy</a>
        <a href="/onemind/plugins/">Plugins</a>
        <a href="/onemind/robotics/">Hardware</a>
        <a href="/onemind/nats/">NATS Bus</a>
        <a href="/onemind/education/">Education</a>
        <a href="/onemind/tools/">Tools</a>
      </div>

      <div class="footer-link-group">
        <div class="footer-link-heading">Resources</div>
        <a href="/resources/starter-kit/">Starter Kit</a>
        <a href="/resources/github/">GitHub</a>
        <a href="/resources/community/">Community ↗</a>
      </div>

      <div class="footer-link-group">
        <div class="footer-link-heading">Site</div>
        <a href="/">Home</a>
        <a href="/about/">About</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2026 Zeus DeLaCruz · OneMind OS · Built on sovereign infrastructure · No cookies. No trackers. No third-party scripts except where you opt in (Zoho forms).</p>
    </div>
  </footer>
</body>
</html>
